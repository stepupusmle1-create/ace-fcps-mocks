generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String    @default("")
  passwordHash String
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  attempts     Attempt[]
}

model System {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  order       Int     @default(0)
  topics      Topic[]
}

model Topic {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String
  order       Int        @default(0)
  systemId    String
  system      System     @relation(fields: [systemId], references: [id])
  questions   Question[]

  @@index([systemId])
}

model Question {
  id                       String          @id @default(cuid())
  topicId                  String
  topic                    Topic           @relation(fields: [topicId], references: [id])
  stem                     String
  optionsJson              String
  correctIndex             Int
  explanation              String
  optionExplanationsJson   String?
  reference                String?
  explanationImagesJson    String?
  isRecall                 Boolean         @default(false)
  createdAt                DateTime        @default(now())
  attemptAnswers           AttemptAnswer[]

  @@index([topicId])
  @@index([topicId, isRecall])
}

model Attempt {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  examType          String
  mode              String          @default("MOCK")
  systemId          String?
  systemName        String?
  topicId           String?
  topicName         String?
  questionOrderJson String
  totalQuestions    Int
  correctCount      Int             @default(0)
  percent           Float           @default(0)
  timeLimitSec      Int
  durationSec       Int             @default(0)
  status            String          @default("IN_PROGRESS")
  startedAt         DateTime        @default(now())
  submittedAt       DateTime?
  answers           AttemptAnswer[]

  @@index([userId])
}

model AttemptAnswer {
  id            String   @id @default(cuid())
  attemptId     String
  attempt       Attempt  @relation(fields: [attemptId], references: [id])
  questionId    String
  question      Question @relation(fields: [questionId], references: [id])
  order         Int
  selectedIndex Int?
  correct       Boolean  @default(false)

  @@index([attemptId])
}
